{
  "_opis": "Beka Fabryka — stan w Make (AKTYWNA, 10:00): Make AI (large) → strażnik → czeka/odrzucony",
  "scenarioId": 6508676,
  "scheduling": {
    "time": "10:00",
    "type": "daily"
  },
  "blueprint": {
    "name": "Beka Fabryka — trendy → oryginalne posty (AI)",
    "metadata": {
      "instant": false,
      "version": 1,
      "designer": {
        "orphans": []
      },
      "scenario": {
        "dlq": false,
        "slots": null,
        "dataloss": false,
        "maxErrors": 6,
        "autoCommit": true,
        "roundtrips": 1,
        "sequential": true,
        "confidential": false,
        "freshVariables": false,
        "autoCommitTriggerLast": true
      }
    },
    "flow": [
      {
        "id": 1,
        "mapper": {
          "url": "https://news.google.com/rss/search?q=%28pogoda%20OR%20upa%C5%82%20OR%20Biedronka%20OR%20Lidl%20OR%20PKP%20OR%20korki%20OR%20ceny%20OR%20urlop%20OR%20weekend%20OR%20szko%C5%82a%20OR%20remont%20OR%20dzia%C5%82ka%29%20when%3A1d&hl=pl&gl=PL&ceid=PL:pl",
          "gzip": true,
          "maxResults": 2
        },
        "module": "rss:ActionReadArticles",
        "version": 4,
        "metadata": {
          "designer": {
            "x": 0,
            "y": 0
          }
        },
        "parameters": {
          "include": ""
        }
      },
      {
        "id": 2,
        "mapper": {
          "filter": [
            [
              {
                "a": "temat",
                "b": "{{1.title}}",
                "o": "text:equal"
              }
            ]
          ]
        },
        "module": "datastore:SearchRecord",
        "version": 1,
        "metadata": {
          "designer": {
            "x": 250,
            "y": 0
          }
        },
        "parameters": {
          "limit": 1,
          "datastore": 145060,
          "continueWhenNoRes": true
        }
      },
      {
        "id": 4,
        "filter": {
          "name": "Tylko nowe tematy (deduplikacja)",
          "conditions": [
            [
              {
                "a": "{{ifempty(2.key; \"BRAK\")}}",
                "b": "BRAK",
                "o": "text:equal"
              }
            ]
          ]
        },
        "mapper": {
          "input": "Jesteś autorem fanpage'a BekaWpigułce – polski humor obserwacyjny o codzienności. Inspiracja dnia (nagłówek z Polski, NIE cytuj go, nie podawaj z niego nazwisk ani nazw firm): {{1.title}}. Napisz JEDEN oryginalny post na Facebooka o sytuacji, którą zna każdy Polak, luźno związanej z tym tematem. Jeśli temat dotyczy polityki, przestępstwa, wypadku, choroby, śmierci, wojny, religii albo konkretnych osób, całkowicie go pomiń i napisz o zwykłej codzienności (praca, zakupy, pogoda, dom, rodzina, dojazdy). Budowa posta: pierwsza linijka to hook do 80 znaków, który zatrzymuje scrollowanie; pusta linia; 2–3 krótkie zdania rozwinięcia z jednym konkretnym, obrazowym szczegółem; pusta linia; zabawna puenta; pusta linia; jedno otwarte pytanie, które zachęca do opisania własnej historii albo wyboru jednej z opcji. Zakazy: żadnych hashtagów, linków, nazwisk, wulgaryzmów, żadnych próśb typu polub, udostępnij, oznacz znajomego, żadnych wstępów typu Oto post, żadnych cudzysłowów wokół całego tekstu. Styl: luz, autoironia, poprawna polszczyzna z polskimi znakami, maksymalnie 2 emoji. Długość 250–450 znaków. Zwróć wyłącznie gotowy tekst posta."
        },
        "module": "ai-tools:Ask",
        "version": 2,
        "metadata": {
          "designer": {
            "x": 500,
            "y": 0
          }
        },
        "parameters": {
          "makeConnectionId": 8363058,
          "model": "large"
        },
        "onerror": [
          {
            "id": 9,
            "module": "builtin:Ignore",
            "version": 1,
            "metadata": {
              "designer": {
                "x": 500,
                "y": 200
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "module": "util:ComposeTransformer",
        "version": 1,
        "parameters": {},
        "mapper": {
          "value": "{{trim(4.answer)}}"
        },
        "metadata": {
          "designer": {
            "x": 750,
            "y": 0
          }
        }
      },
      {
        "id": 5,
        "mapper": null,
        "module": "builtin:BasicRouter",
        "version": 1,
        "metadata": {
          "designer": {
            "x": 1000,
            "y": 0
          }
        },
        "routes": [
          {
            "flow": [
              {
                "id": 6,
                "filter": {
                  "name": "Strażnik jakości OK",
                  "conditions": [
                    [
                      {
                        "a": "{{length(8.value)}}",
                        "b": "120",
                        "o": "number:greaterorequal"
                      },
                      {
                        "a": "{{length(8.value)}}",
                        "b": "700",
                        "o": "number:lessorequal"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "?",
                        "o": "text:contain"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "#",
                        "o": "text:notcontain"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "http",
                        "o": "text:notcontain:ci"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "oto post",
                        "o": "text:notcontain:ci"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "jako ai",
                        "o": "text:notcontain:ci"
                      },
                      {
                        "a": "{{8.value}}",
                        "b": "jako model",
                        "o": "text:notcontain:ci"
                      }
                    ]
                  ]
                },
                "mapper": {
                  "key": "",
                  "overwrite": false,
                  "data": {
                    "temat": "{{1.title}}",
                    "status": "czeka",
                    "publikuj_o": "{{now}}",
                    "tekst_posta": "{{8.value}}\n\n#BekaWpigułce",
                    "url_grafiki": "https://raw.githubusercontent.com/Toruniiak/beka-radar/6e18779826be40054436e943e58f761617b1f8e6/karty/dzien-{{formatDate(now; \"d\")}}.png",
                    "zrodlo_inspiracji": "{{1.url}}"
                  }
                },
                "module": "datastore:AddRecord",
                "version": 1,
                "metadata": {
                  "designer": {
                    "x": 1250,
                    "y": -150
                  }
                },
                "parameters": {
                  "datastore": 145060
                }
              }
            ]
          },
          {
            "flow": [
              {
                "id": 7,
                "filter": {
                  "name": "Odrzucone przez strażnika (log)",
                  "conditions": [
                    [
                      {
                        "a": "{{length(8.value)}}",
                        "b": "120",
                        "o": "number:less"
                      }
                    ],
                    [
                      {
                        "a": "{{length(8.value)}}",
                        "b": "700",
                        "o": "number:greater"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "?",
                        "o": "text:notcontain"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "#",
                        "o": "text:contain"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "http",
                        "o": "text:contain:ci"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "oto post",
                        "o": "text:contain:ci"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "jako ai",
                        "o": "text:contain:ci"
                      }
                    ],
                    [
                      {
                        "a": "{{8.value}}",
                        "b": "jako model",
                        "o": "text:contain:ci"
                      }
                    ]
                  ]
                },
                "mapper": {
                  "key": "",
                  "overwrite": false,
                  "data": {
                    "temat": "{{1.title}}",
                    "status": "odrzucony",
                    "publikuj_o": "{{now}}",
                    "tekst_posta": "{{substring(8.value; 0; 1500)}}",
                    "url_grafiki": "-",
                    "zrodlo_inspiracji": "{{1.url}}"
                  }
                },
                "module": "datastore:AddRecord",
                "version": 1,
                "metadata": {
                  "designer": {
                    "x": 1250,
                    "y": 150
                  }
                },
                "parameters": {
                  "datastore": 145060
                }
              }
            ]
          }
        ]
      }
    ]
  }
}